# .env.example — every bootstrap config value Phases 2-4 introduced
# (Postgres DSN, GitHub App credential fields, LLM endpoint), per the plan's
# Phase 5 section and the C4 doc's "Compose reads local config from a plain
# .env file, with a developer free to source it from their own tool" note.
#
# Copy this file to `.env` (already gitignored — see .gitignore) and
# replace every placeholder with a real value before running
# `docker compose up`. This file itself must only ever contain placeholder
# values — never a real secret — per the plan's Security review ("Secrets
# never committed").

# --- Postgres (Phase 2, adapter/storage) ---
# Consumed by the `postgres` and `migrate` services in docker-compose.yml.
POSTGRES_USER=review
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=review
POSTGRES_PORT=5432

# The async SQLAlchemy DSN Alembic reads directly (adapter/storage/
# migrations/env.py) to run migrations, and that Phase 2's
# pgvector-presence check (adapter/storage/startup_check_cli.py) uses at
# compose-boot time. Must stay in sync with the POSTGRES_* values above if
# you change them — inside the Compose network the host is the `postgres`
# service name, not `localhost`.
REVIEW_DATABASE_URL=postgresql+asyncpg://review:change-me-local-dev-only@postgres:5432/review

# --- Webhook API (Phase 1 scaffold + resolution/enqueue, Phase 4 credentials) ---
# Note: the GitHub App ID and private key returned by the manifest/callback
# setup flow below are handed back to the operator in the HTTP response
# (see apps/webhook_api/manifest_routes.py) rather than read back here as
# env config — nothing in Phase 0 authenticates to the GitHub API with
# them yet (see adapter/storage/models.py's module docstring on the
# bootstrap-vs-day-two config split). A later roadmap phase that adds real
# GitHub API calls under the App's identity introduces the corresponding
# settings field and .env.example entry then, not speculatively here.
REVIEW_WEBHOOK_API_ENVIRONMENT=development
REVIEW_WEBHOOK_API_LOG_LEVEL=INFO
WEBHOOK_API_PORT=8000

# Required, no default: the HMAC secret the webhook receiver verifies every
# inbound GitHub delivery against — this phase's first trust boundary (see
# the plan's Security review). Generate a real one for anything beyond
# local dev, e.g. `openssl rand -hex 32`.
REVIEW_WEBHOOK_API_GITHUB_WEBHOOK_SECRET=replace-with-a-real-webhook-secret

REVIEW_WEBHOOK_API_WEBHOOK_MAX_BODY_BYTES=1000000
REVIEW_WEBHOOK_API_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=30
REVIEW_WEBHOOK_API_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# Per-repo review-enqueue rate limit (Phase 1) — disabled (0) by default,
# matching phase-1-review-pipeline.md's current NFR text exactly ("no
# additional cross-review rate-limiting is specified for Phase 1"). This is
# a genuine, deliberate reversal of that NFR this plan built but did not
# activate by default — see the plan's Phase 1 "Assumptions" section for
# the full cost-exhaustion reasoning. Set above 0 (10 is this plan's own
# recommended starting point) only after reviewing that reasoning; a
# startup `warning` log states plainly whether this is active.
REVIEW_WEBHOOK_API_REVIEW_ENQUEUE_RATE_LIMIT_PER_MINUTE=0

# Indexing kill switch (plan-indexing-delivery.md's Phase 1) — off by
# default (Assumption 11): no `INDEX` job is ever enqueued, regardless of
# trigger match, until an operator makes the affirmative choice to set this
# `true` once the Worker actually knows how to run an `INDEX` job (that
# plan's Phase 7). A startup `warning` log states plainly whether this is
# active.
REVIEW_WEBHOOK_API_INDEXING_ENABLED=false

# Per-repo index-enqueue rate limit (plan-indexing-delivery.md's Phase 1,
# Assumption 10) — shared across both `push`- and `pull_request`-triggered
# `INDEX` enqueues for the same repo. Unlike the review-enqueue limiter
# above, this ships *enabled* by default (5/minute is this plan's own
# recommended starting point): an `INDEX` job's worst-case cost is
# materially higher than a `REVIEW` job's. Set to 0 to disable entirely; a
# startup `warning`/`info` log states plainly whether this is active.
REVIEW_WEBHOOK_API_INDEX_ENQUEUE_RATE_LIMIT_PER_MINUTE=5

# Memory capture (docs/plans/plan-deliver-memory.md's Phase 3, Unit C) —
# reply-text redaction before persistence (mirrors REVIEW_WORKER's own
# SECRET_REDACTION_ENABLED field name/default exactly) and a per-repo daily
# cap on capture writes, bounding unauthenticated write volume from any
# GitHub account able to comment/react on a public repo's PR.
REVIEW_WEBHOOK_API_SECRET_REDACTION_ENABLED=true
REVIEW_WEBHOOK_API_MEMORY_CAPTURE_CEILING_PER_REPO_PER_DAY=500

# GitHub App manifest/callback setup flow (adapter/github, Phase 4) — off
# by default per the plan's Security review ("Manifest-flow gating": no
# admin authn/authz surface exists yet, so this must stay gated). Only
# enable for the duration of a one-time App-creation flow, then turn back
# off.
REVIEW_WEBHOOK_API_SETUP_MODE=false
# Required only when SETUP_MODE=true — signs the manifest flow's CSRF
# state cookie. Generate with e.g. `openssl rand -hex 32`; never reuse the
# webhook secret above for this.
REVIEW_WEBHOOK_API_SETUP_STATE_SECRET=
REVIEW_WEBHOOK_API_SETUP_STATE_TTL_SECONDS=600
REVIEW_WEBHOOK_API_GITHUB_API_BASE_URL=https://api.github.com
REVIEW_WEBHOOK_API_GITHUB_API_TIMEOUT_SECONDS=10

# GitHub App auth for the synchronous reaction-fetch path
# (docs/plans/plan-deliver-memory.md's Phase 4, Unit D, US-M3's second
# `Given/When/Then` branch: a `pull_request closed` event's reaction fetch
# must run before this route's handler returns, not queued for the Worker
# to pick up later — so this entrypoint needs its own installation-token
# exchange capability, same credentials as REVIEW_WORKER_GITHUB_APP_* below
# (the same GitHub App, a second process reading the same identity).
# Required, no default — never commit real values here (see this file's own
# header comment).
REVIEW_WEBHOOK_API_GITHUB_APP_ID=
REVIEW_WEBHOOK_API_GITHUB_APP_PRIVATE_KEY=
# Same "retries beyond the first attempt" lever
# REVIEW_WORKER_GITHUB_RETRY_MAX_ATTEMPTS below already documents.
REVIEW_WEBHOOK_API_GITHUB_RETRY_MAX_ATTEMPTS=3
# Same ceiling/reasoning as REVIEW_WORKER_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL
# below — this entrypoint's own copy, since the synchronous `closed`-trigger
# poll runs here, not in the Worker.
REVIEW_WEBHOOK_API_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL=50

# Memory admin API (docs/plans/plan-deliver-memory.md's Phase 5, Unit E,
# US-M4/US-M5/US-M8/US-M10). Required, no default — mirrors
# REVIEW_WEBHOOK_API_GITHUB_WEBHOOK_SECRET's own "no safe default,
# dangerous to silently default" pattern; the admin router registers
# unconditionally and enforces this key per-request via a Bearer-token
# check. Never commit a real value here (see this file's own header
# comment).
REVIEW_WEBHOOK_API_ADMIN_API_KEY=
# This entrypoint's own local embedding model path — the admin API's
# approve route (US-M4) is its first consumer outside the Worker's own job
# pipeline. Same default/shape as REVIEW_WORKER_EMBEDDING_MODEL_PATH below;
# checked to load and produce a real inference result once at Webhook API
# startup, the same fail-fast pattern as that field's own check.
REVIEW_WEBHOOK_API_EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# --- Worker / LLM Gateway (Phase 3, apps/worker + adapter/llm) ---
REVIEW_WORKER_ENVIRONMENT=development
REVIEW_WORKER_LOG_LEVEL=INFO

# LM Studio's OpenAI-compatible endpoint on the Docker host, per the C4
# doc's Level 3 diagram. `host.docker.internal` resolves to your machine
# from inside the worker container (docker-compose.yml adds the
# `extra_hosts` entry plain Docker Engine on Linux needs for this to work;
# Docker Desktop provides it for free). Point this at a real hosted
# provider's OpenAI-compatible endpoint instead for anything beyond local
# dev against LM Studio.
REVIEW_WORKER_LLM_ENDPOINT=http://host.docker.internal:1234/v1
# LM Studio ignores this value but the OpenAI-compatible wire format still
# requires the header to be present; a real hosted provider needs a real
# key here.
REVIEW_WORKER_LLM_API_KEY=not-needed
REVIEW_WORKER_LLM_MODEL=local-model
REVIEW_WORKER_LLM_TIMEOUT_SECONDS=30

# Job dispatch loop (Phase 3, apps/worker/dispatch.py) — how often to poll
# the job queue when it's empty, and the threshold past which a still-
# running job gets a `warning` log (a visibility mitigation for the
# not-yet-built reclaim-timeout gap, not a timeout itself; recalculated by
# docs/plans/plan-deliver-verification-pipeline.md's Phase 5 section now
# that intent_summary/verification exist — see that plan's US-V9 NFR
# section for the full worst-case-chain-sum basis behind 600).
REVIEW_WORKER_POLL_INTERVAL_SECONDS=2
REVIEW_WORKER_STUCK_JOB_WARNING_THRESHOLD_SECONDS=600

# Pipeline step framework (Phase 2, review/pipeline.py + review/config.py) —
# one enable/disable boolean per macro step, and one timeout-in-seconds
# field per macro step plus one shared field covering both of the
# static-analysis step's own analyzer sub-steps (Gitleaks/Semgrep, wired up
# in Phase 5). Defaults below match review.config.StepEnablement/StepTimeouts'
# own defaults exactly; see the plan's Phase 2 section for the reasoning
# behind each timeout figure. `*_REVIEW_GENERATION_*` renamed from
# `*_LLM_REVIEW_*` by docs/plans/plan-deliver-verification-pipeline.md's
# Phase 5 section (a deliberate, documented breaking rename — see that
# plan's Compatibility & rollout section); `*_INTENT_SUMMARY_*`/
# `*_VERIFICATION_*` are new, added by that same phase.
REVIEW_WORKER_PREFILTER_ENABLED=true
REVIEW_WORKER_STATIC_ANALYSIS_ENABLED=true
REVIEW_WORKER_INTENT_SUMMARY_ENABLED=true
REVIEW_WORKER_REVIEW_GENERATION_ENABLED=true
REVIEW_WORKER_VERIFICATION_ENABLED=true
REVIEW_WORKER_OUTPUT_ENABLED=true
REVIEW_WORKER_PREFILTER_STEP_TIMEOUT_SECONDS=30
REVIEW_WORKER_STATIC_ANALYSIS_STEP_TIMEOUT_SECONDS=240
REVIEW_WORKER_STATIC_ANALYSIS_ANALYZER_TIMEOUT_SECONDS=60
REVIEW_WORKER_INTENT_SUMMARY_STEP_TIMEOUT_SECONDS=30
REVIEW_WORKER_REVIEW_GENERATION_STEP_TIMEOUT_SECONDS=90
REVIEW_WORKER_VERIFICATION_STEP_TIMEOUT_SECONDS=60
REVIEW_WORKER_OUTPUT_STEP_TIMEOUT_SECONDS=30

# Context Builder (docs/plans/plan-deliver-context-builder.md's Phase 5
# section, review/context_builder.py) — this step's own kill switch, plus
# its two distinct timeouts: the outer per-step timeout the pipeline
# registry reads, and the internal timeout bounding its own whole
# orchestration in a single `asyncio.wait_for` (strictly less than the
# outer one, enforced by a WorkerSettings validator — see that module's
# own docstring for why).
REVIEW_WORKER_CONTEXT_BUILDER_ENABLED=true
REVIEW_WORKER_CONTEXT_BUILDER_STEP_TIMEOUT_SECONDS=35
REVIEW_WORKER_CONTEXT_BUILDER_INTERNAL_TIMEOUT_SECONDS=25

# Static-analysis analyzer sub-steps (Phase 5, adapter/analyzers/gitleaks.py +
# semgrep.py) — toggled independently per US-F4.
REVIEW_WORKER_STATIC_ANALYSIS_GITLEAKS_ENABLED=true
REVIEW_WORKER_STATIC_ANALYSIS_SEMGREP_ENABLED=true

# Secret redaction (Phase 5, findings/redact.py) — default-active (a
# baseline-engineering-practice mitigation for a live secret-leak vector,
# not a product/cost-policy tradeoff; see the plan's "Assumptions this plan
# makes" section). Independent of REVIEW_WORKER_STATIC_ANALYSIS_GITLEAKS_ENABLED
# above on purpose: disabling the Gitleaks *scanner* sub-step for noise
# reasons must never silently disable redaction of a secret the LLM (Phase
# 6) echoes back verbatim into its own finding prose. Disabling this
# reopens a live secret-leak vector into a permanently-posted PR comment —
# a startup `warning` log states plainly when it's off.
REVIEW_WORKER_SECRET_REDACTION_ENABLED=true

# --- Review-generation step (Phase 6, review/review_generation.py, renamed
# from review/llm_review.py by
# docs/plans/plan-deliver-verification-pipeline.md's Phase 2 section) ---
# A fixed byte ceiling on the diff text included in the LLM prompt — diff
# size is fully PR-author-controlled and directly drives LLM token cost, so
# an oversized PR truncates rather than sending an unbounded prompt.
REVIEW_WORKER_LLM_MAX_DIFF_BYTES=200000

# --- Local embedding client (indexing delivery plan Phase 4,
# adapter/embedding/local_onnx.py) ---
# The on-disk directory the Dockerfile's checksum-verified `embedding-model`
# build stage bakes the bundled local embedding model weights into — a
# purely local filesystem path, no network call at inference time. Verified
# to load and produce a real inference result once at Worker startup
# (adapter/embedding/startup_check.py), the same fail-fast pattern as the
# LLM-reachability/GitHub-private-key checks above.
REVIEW_WORKER_EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# --- GitHub App auth / diff fetch (Phase 4, adapter/github/auth.py + diff.py) ---
# Required, no default: the GitHub App's own identity and private key,
# needed for the server-to-server auth flow (signing a JWT, exchanging it
# for a short-lived, repo-scoped installation access token) that
# diff-fetch depends on. Get these from the App's settings page (or the
# manifest/callback setup flow's response, apps/webhook_api/manifest_routes.py) —
# never commit real values here (see this file's own header comment).
# Validated at Worker startup by attempting one real RS256 signing call
# with it; a malformed/truncated value fails loudly at boot, not silently
# on the first real job.
REVIEW_WORKER_GITHUB_APP_ID=
REVIEW_WORKER_GITHUB_APP_PRIVATE_KEY=

# Reuses the same base-URL/timeout pattern REVIEW_WEBHOOK_API_GITHUB_API_*
# above already establishes.
REVIEW_WORKER_GITHUB_API_BASE_URL=https://api.github.com
REVIEW_WORKER_GITHUB_API_TIMEOUT_SECONDS=10
# The GitHub-side retry/backoff policy's own configurable lever (a bare 5xx
# retries with short exponential backoff up to this many times; a
# 429/secondary-rate-limit response honors Retry-After up to a 10-second
# cap, treated as one bounded retry regardless of this value). `0` disables
# the mechanism wholesale.
REVIEW_WORKER_GITHUB_RETRY_MAX_ATTEMPTS=3

# --- Memory reaction polling (docs/plans/plan-deliver-memory.md's Phase 4
# section, Unit D, US-M3) --- bounds worst-case GitHub API call volume per
# poll: only the most-recently-posted comments for a PR, up to this many,
# are ever polled for reactions on a given poll.
REVIEW_WORKER_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL=50

# --- Memory-based suppression (docs/plans/plan-deliver-memory.md's Phase 6
# section, Unit F, US-M6/US-M7/US-M9/US-M12) --- an internal behavior toggle
# inside the already-registered `verification` step, not a separate pipeline
# stage of its own. Set false as the operational rollback lever if a bad
# threshold or a wrongly-approved entry starts suppressing findings it
# shouldn't — capture and the admin API keep running regardless.
REVIEW_WORKER_MEMORY_SUPPRESSION_ENABLED=true
# Tunable bootstrap config, not a hardcoded constant — the cosine-similarity
# threshold above which a candidate finding is suppressed.
REVIEW_WORKER_MEMORY_SIMILARITY_THRESHOLD=0.90
# Tunable bootstrap config — the exponential half-life, in days, an approved
# entry's similarity weight decays by (never a deletion/expiry job).
REVIEW_WORKER_MEMORY_DECAY_HALF_LIFE_DAYS=180.0

# --- Findings-merge-and-output step (Phase 7, review/output.py) ---
# A single bootstrap-config kill-switch: when true, the full pipeline still
# runs (merge/redaction included) but every real GitHub write (PR review,
# check-run) is suppressed and the would-be payload is logged at `info`
# instead. Defaults to false — Phase 1's own shipped default posts real
# reviews; set true to validate a fresh deployment before trusting it with
# real writes.
REVIEW_WORKER_DRY_RUN=false

# --- Observability (docs/specs/spec-observability.md's Unit A) ---
# Shared, UNPREFIXED across both entrypoints (like REVIEW_DATABASE_URL
# above) — the real OTel ecosystem convention, the same literal env var
# name every OTel SDK/exporter/collector already recognizes, not this
# repo's own REVIEW_WEBHOOK_API_*/REVIEW_WORKER_* prefix. Optional:
# unset (the shipped default) means no OTel SDK/exporter is constructed
# at all — zero overhead, zero connection attempts, zero log noise
# (US10's no-op default). Set to an OTel Collector's OTLP gRPC receiver
# address (e.g. `http://otel-collector:4317`) to enable metrics/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional OTLP auth headers for a collector that requires them (e.g.
# `authorization=Bearer <token>` for a bearer token), in OTel's own
# `key1=value1,key2=value2` wire format. Only meaningful when
# OTEL_EXPORTER_OTLP_ENDPOINT above is set; never commit a real token
# here (see this file's own header comment).
OTEL_EXPORTER_OTLP_HEADERS=

# --- `observability` Compose profile (Unit F) ---
# `docker compose --profile observability up` additionally starts an OTel
# Collector, Prometheus, and Grafana (pre-loaded with the shipped
# dashboard) alongside the default stack — see docker-compose.yml's own
# "observability profile" comment. That profile only brings the
# *containers* up; to actually see data in the bundled Grafana, also set
# OTEL_EXPORTER_OTLP_ENDPOINT above to the bundled collector's address:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# left unset here on purpose, matching every other value in this file —
# Compose profiles gate which *services* start, not env var values, so
# this one step can't be made to happen automatically just by passing
# `--profile observability`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_PROMETHEUS_PORT=8889
