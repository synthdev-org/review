# .env.example — every bootstrap config value (Postgres DSN, GitHub App
# credential fields, LLM endpoint), per the C4 doc's "Compose reads local
# config from a plain .env file, with a developer free to source it from
# their own tool" note.
#
# Copy this file to `.env` (already gitignored — see .gitignore) and
# replace every placeholder with a real value before running
# `docker compose up`. This file itself must only ever contain placeholder
# values — never a real secret.

# --- Postgres (adapter/storage) ---
# Consumed by the `postgres` and `migrate` services in docker-compose.yml.
POSTGRES_USER=review
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=review
POSTGRES_PORT=5432

# The async SQLAlchemy DSN Alembic reads directly (adapter/storage/
# migrations/env.py) to run migrations, and that the
# pgvector-presence check (adapter/storage/startup_check_cli.py) uses at
# compose-boot time. Must stay in sync with the POSTGRES_* values above if
# you change them — inside the Compose network the host is the `postgres`
# service name, not `localhost`.
REVIEW_DATABASE_URL=postgresql+asyncpg://review:change-me-local-dev-only@postgres:5432/review

# --- Webhook API ---
# Note: the GitHub App ID and private key returned by the manifest/callback
# setup flow below are handed back to the operator in the HTTP response
# (see apps/webhook_api/manifest_routes.py) rather than read back here as
# env config — nothing in the Webhook API authenticates to the GitHub API with
# them yet (see adapter/storage/models.py's module docstring on the
# bootstrap-vs-day-two config split). A later change that adds real
# GitHub API calls under the App's identity introduces the corresponding
# settings field and .env.example entry then, not speculatively here.
REVIEW_WEBHOOK_API_ENVIRONMENT=development
REVIEW_WEBHOOK_API_LOG_LEVEL=INFO
WEBHOOK_API_PORT=8000

# Required, no default: the HMAC secret the webhook receiver verifies every
# inbound GitHub delivery against — the first trust boundary. Generate a
# real one for anything beyond local dev, e.g. `openssl rand -hex 32`.
REVIEW_WEBHOOK_API_GITHUB_WEBHOOK_SECRET=replace-with-a-real-webhook-secret

REVIEW_WEBHOOK_API_WEBHOOK_MAX_BODY_BYTES=1000000
REVIEW_WEBHOOK_API_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=30
REVIEW_WEBHOOK_API_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# Per-repo review-enqueue rate limit — disabled (0) by default. Without a
# limit, a burst of PR events can exhaust LLM budget. Set above 0 (10 is a
# reasonable starting point) to enable it; a startup `warning` log states
# plainly whether this is active.
REVIEW_WEBHOOK_API_REVIEW_ENQUEUE_RATE_LIMIT_PER_MINUTE=0

# Indexing kill switch — off by default: no `INDEX` job is ever enqueued,
# regardless of trigger match, until an operator makes the affirmative
# choice to set this `true`. A startup `warning` log states plainly whether this is
# active.
REVIEW_WEBHOOK_API_INDEXING_ENABLED=false

# Per-repo index-enqueue rate limit — shared across both `push`- and `pull_request`-triggered
# `INDEX` enqueues for the same repo. Unlike the review-enqueue limiter
# above, this ships *enabled* by default (5/minute is the
# recommended starting point): an `INDEX` job's worst-case cost is
# materially higher than a `REVIEW` job's. Set to 0 to disable entirely; a
# startup `warning`/`info` log states plainly whether this is active.
REVIEW_WEBHOOK_API_INDEX_ENQUEUE_RATE_LIMIT_PER_MINUTE=5

# Memory capture — reply-text redaction before persistence (mirrors REVIEW_WORKER's own
# SECRET_REDACTION_ENABLED field name/default exactly) and a per-repo daily
# cap on capture writes, bounding unauthenticated write volume from any
# GitHub account able to comment/react on a public repo's PR.
REVIEW_WEBHOOK_API_SECRET_REDACTION_ENABLED=true
REVIEW_WEBHOOK_API_MEMORY_CAPTURE_CEILING_PER_REPO_PER_DAY=500

# GitHub App manifest/callback setup flow (adapter/github) — off by
# default, so the setup surface stays gated. Only enable for the duration
# of a one-time App-creation flow, then turn back off.
REVIEW_WEBHOOK_API_SETUP_MODE=false
# Required only when SETUP_MODE=true — signs the manifest flow's CSRF
# state cookie. Generate with e.g. `openssl rand -hex 32`; never reuse the
# webhook secret above for this.
REVIEW_WEBHOOK_API_SETUP_STATE_SECRET=
REVIEW_WEBHOOK_API_SETUP_STATE_TTL_SECONDS=600
REVIEW_WEBHOOK_API_GITHUB_API_BASE_URL=https://api.github.com
REVIEW_WEBHOOK_API_GITHUB_API_TIMEOUT_SECONDS=10

# GitHub App auth for the synchronous reaction-fetch path
# (US-M3's second `Given/When/Then` branch: a `pull_request closed` event's reaction fetch
# must run before this route's handler returns, not queued for the Worker
# to pick up later — so this entrypoint needs its own installation-token
# exchange capability, same credentials as REVIEW_WORKER_GITHUB_APP_* below
# (the same GitHub App, a second process reading the same identity).
# Required, no default — never commit real values here (see this file's own
# header comment).
REVIEW_WEBHOOK_API_GITHUB_APP_ID=
REVIEW_WEBHOOK_API_GITHUB_APP_PRIVATE_KEY=
# Same "retries beyond the first attempt" lever
# REVIEW_WORKER_GITHUB_RETRY_MAX_ATTEMPTS below already documents.
REVIEW_WEBHOOK_API_GITHUB_RETRY_MAX_ATTEMPTS=3
# Same ceiling/reasoning as REVIEW_WORKER_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL
# below — this entrypoint's own copy, since the synchronous `closed`-trigger
# poll runs here, not in the Worker.
REVIEW_WEBHOOK_API_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL=50

# --- Worker / LLM Gateway (apps/worker + adapter/llm) ---
REVIEW_WORKER_ENVIRONMENT=development
REVIEW_WORKER_LOG_LEVEL=INFO

# LM Studio's OpenAI-compatible endpoint on the Docker host, per the C4
# doc's Level 3 diagram. `host.docker.internal` resolves to your machine
# from inside the worker container (docker-compose.yml adds the
# `extra_hosts` entry plain Docker Engine on Linux needs for this to work;
# Docker Desktop provides it for free). Point this at a real hosted
# provider's OpenAI-compatible endpoint instead for anything beyond local
# dev against LM Studio.
REVIEW_WORKER_LLM_ENDPOINT=http://host.docker.internal:1234/v1
# LM Studio ignores this value but the OpenAI-compatible wire format still
# requires the header to be present; a real hosted provider needs a real
# key here.
REVIEW_WORKER_LLM_API_KEY=not-needed
REVIEW_WORKER_LLM_MODEL=local-model
REVIEW_WORKER_LLM_TIMEOUT_SECONDS=30

# Job dispatch loop (apps/worker/dispatch.py) — how often to poll
# the job queue when it's empty, and the threshold past which a still-
# running job gets a `warning` log (a visibility mitigation for the
# not-yet-built reclaim-timeout gap, not a timeout itself; sized from the
# worst-case sum of the step timeouts (see US-V9 in
# docs/specs/spec-verification-pipeline.md): 575s * 1.15 = 660).
REVIEW_WORKER_POLL_INTERVAL_SECONDS=2
REVIEW_WORKER_STUCK_JOB_WARNING_THRESHOLD_SECONDS=660

# Pipeline step framework (review/pipeline.py + review/config.py) —
# one enable/disable boolean per macro step, and one timeout-in-seconds
# field per macro step plus one shared field covering both of the
# static-analysis step's own analyzer sub-steps (Gitleaks/Semgrep, wired up
# separately). Defaults below match review.config.StepEnablement/StepTimeouts'
# own defaults exactly. `*_REVIEW_GENERATION_*` was renamed from
# `*_LLM_REVIEW_*` (a deliberate breaking rename); `*_INTENT_SUMMARY_*`/
# `*_VERIFICATION_*` were added with the verification pipeline.
REVIEW_WORKER_PREFILTER_ENABLED=true
REVIEW_WORKER_STATIC_ANALYSIS_ENABLED=true
REVIEW_WORKER_INTENT_SUMMARY_ENABLED=true
# Appends the 12-smell baseline to the review_generation prompt (kill switch).
REVIEW_WORKER_SMELL_BASELINE_ENABLED=true
# Spec-compliance check (extra LLM call; findings go through verification). Kill switch.
REVIEW_WORKER_SPEC_REVIEW_ENABLED=true
# v2 review-quality bundle: new prompt, scenario/tier fields, extra verification criterion.
# Per worker process; roll back with false plus a worker restart.
REVIEW_WORKER_REVIEW_QUALITY_V2_ENABLED=false
REVIEW_WORKER_REVIEW_GENERATION_ENABLED=true
REVIEW_WORKER_VERIFICATION_ENABLED=true
REVIEW_WORKER_OUTPUT_ENABLED=true
REVIEW_WORKER_PREFILTER_STEP_TIMEOUT_SECONDS=30
REVIEW_WORKER_STATIC_ANALYSIS_STEP_TIMEOUT_SECONDS=240
REVIEW_WORKER_STATIC_ANALYSIS_ANALYZER_TIMEOUT_SECONDS=60
REVIEW_WORKER_INTENT_SUMMARY_STEP_TIMEOUT_SECONDS=30
REVIEW_WORKER_REVIEW_GENERATION_STEP_TIMEOUT_SECONDS=90
REVIEW_WORKER_VERIFICATION_STEP_TIMEOUT_SECONDS=120
# spec_review's internal deadline must stay strictly below its step timeout.
REVIEW_WORKER_SPEC_REVIEW_STEP_TIMEOUT_SECONDS=60
REVIEW_WORKER_SPEC_REVIEW_INTERNAL_TIMEOUT_SECONDS=45
REVIEW_WORKER_OUTPUT_STEP_TIMEOUT_SECONDS=30

# Context Builder (docs/specs/spec-context-builder.md,
# review/context_builder.py) — this step's own kill switch, plus
# its two distinct timeouts: the outer per-step timeout the pipeline
# registry reads, and the internal timeout bounding its own whole
# orchestration in a single `asyncio.wait_for` (strictly less than the
# outer one, enforced by a WorkerSettings validator — see that module's
# own docstring for why).
REVIEW_WORKER_CONTEXT_BUILDER_ENABLED=true
REVIEW_WORKER_CONTEXT_BUILDER_STEP_TIMEOUT_SECONDS=35
REVIEW_WORKER_CONTEXT_BUILDER_INTERNAL_TIMEOUT_SECONDS=25

# Static-analysis analyzer sub-steps (adapter/analyzers/gitleaks.py +
# semgrep.py) — toggled independently per US-F4.
REVIEW_WORKER_STATIC_ANALYSIS_GITLEAKS_ENABLED=true
REVIEW_WORKER_STATIC_ANALYSIS_SEMGREP_ENABLED=true
# Markdown-link and SQL-migration analyzers: off until fixture precision is checked.
REVIEW_WORKER_STATIC_ANALYSIS_MARKDOWN_LINKS_ENABLED=false
REVIEW_WORKER_STATIC_ANALYSIS_MARKDOWN_LINKS_TIMEOUT_SECONDS=10
REVIEW_WORKER_STATIC_ANALYSIS_SQL_MIGRATIONS_ENABLED=false
REVIEW_WORKER_STATIC_ANALYSIS_SQL_MIGRATIONS_TIMEOUT_SECONDS=60

# Secret redaction (findings/redact.py) — default-active (a
# baseline-engineering-practice mitigation for a live secret-leak vector,
# not a product/cost-policy tradeoff). Independent of REVIEW_WORKER_STATIC_ANALYSIS_GITLEAKS_ENABLED
# above on purpose: disabling the Gitleaks *scanner* sub-step for noise
# reasons must never silently disable redaction of a secret the LLM
# echoes back verbatim into its own finding prose. Disabling this
# reopens a live secret-leak vector into a permanently-posted PR comment —
# a startup `warning` log states plainly when it's off.
REVIEW_WORKER_SECRET_REDACTION_ENABLED=true

# --- Review-generation step (review/review_generation.py) ---
# A fixed byte ceiling on the diff text included in the LLM prompt — diff
# size is fully PR-author-controlled and directly drives LLM token cost, so
# an oversized PR truncates rather than sending an unbounded prompt.
REVIEW_WORKER_LLM_MAX_DIFF_BYTES=200000

# --- Diff batching (docs/specs/spec-diff-batching.md) ---
# A diff over the ceiling above is split into batches of related files, one
# LLM call each, instead of being cut. MAX_DIFF_CHUNKS caps the calls per
# review (cost): files in batches past the cap are listed in the posted review
# as "Not reviewed". The step timeouts above must cover
# ceil(MAX_DIFF_CHUNKS / CONCURRENCY) calls of LLM_TIMEOUT_SECONDS (checked at
# startup). DIFF_BATCHING_ENABLED=false restores the single cut diff.
REVIEW_WORKER_DIFF_BATCHING_ENABLED=true
REVIEW_WORKER_MAX_DIFF_CHUNKS=8
REVIEW_WORKER_DIFF_BATCH_CONCURRENCY=4
REVIEW_WORKER_DIFF_BATCH_LINK_TIMEOUT_SECONDS=15

# --- Review context and input shaping (docs/specs/spec-review-context.md) ---
# SHRINK: data/fixture patches over STUB_DATA_MIN_BYTES become a one-line stub,
# deletion-only hunks of 20+ lines collapse, prose patches over PROSE_MAX_BYTES
# are trimmed. Every such file is listed in the posted review as "not reviewed
# in detail"; the file stays in the pipeline diff (static analysis still scans it).
REVIEW_WORKER_REVIEW_SHRINK_ENABLED=true
REVIEW_WORKER_REVIEW_STUB_DATA_MIN_BYTES=8000
REVIEW_WORKER_REVIEW_PROSE_MAX_BYTES=12000
# Risk-ordered batches (source, then tests, docs, data) and a per-file PR map
# in every batch prompt. Both only affect a diff that needs batching. The map
# budget is reserved from LLM_MAX_DIFF_BYTES (0 or PR_MAP_ENABLED=false = off).
REVIEW_WORKER_REVIEW_RISK_ORDERING_ENABLED=true
REVIEW_WORKER_REVIEW_PR_MAP_ENABLED=true
REVIEW_WORKER_REVIEW_PR_MAP_MAX_BYTES=8000
# Show each hunk with its enclosing function (needs DIFF_BATCHING_ENABLED).
# Off by default: it changes the prompt of a PR that fits one batch.
REVIEW_WORKER_REVIEW_HUNK_EXPANSION_ENABLED=false
# Verification judges findings against the head version of the cited files.
# Off by default; sends unchanged code (never .env/.pem/.key or data paths) to
# the LLM endpoint. The step timeout must also cover the fetch timeout.
REVIEW_WORKER_VERIFICATION_FILE_CONTEXT_ENABLED=false
REVIEW_WORKER_VERIFICATION_FILE_CONTEXT_MAX_BYTES=24000
REVIEW_WORKER_VERIFICATION_FILE_CONTEXT_TOTAL_BYTES=80000
REVIEW_WORKER_VERIFICATION_FILE_CONTEXT_TIMEOUT_SECONDS=10
# Commit-by-commit review for a PR that batching cannot cover (needs
# DIFF_BATCHING_ENABLED). Findings no longer present at head are not posted.
# The generation step timeout must also cover the fetch timeout.
REVIEW_WORKER_REVIEW_COMMIT_MODE_ENABLED=false
REVIEW_WORKER_REVIEW_COMMIT_MAX_COMMITS=60
REVIEW_WORKER_REVIEW_COMMIT_FETCH_TIMEOUT_SECONDS=30

# --- Local embedding client (adapter/embedding/local_onnx.py) ---
# The on-disk directory the Dockerfile's checksum-verified `embedding-model`
# build stage bakes the bundled local embedding model weights into — a
# purely local filesystem path, no network call at inference time. Verified
# to load and produce a real inference result once at Worker startup
# (adapter/embedding/startup_check.py), the same fail-fast pattern as the
# LLM-reachability/GitHub-private-key checks above.
REVIEW_WORKER_EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# --- GitHub App auth / diff fetch (adapter/github/auth.py + diff.py) ---
# Required, no default: the GitHub App's own identity and private key,
# needed for the server-to-server auth flow (signing a JWT, exchanging it
# for a short-lived, repo-scoped installation access token) that
# diff-fetch depends on. Get these from the App's settings page (or the
# manifest/callback setup flow's response, apps/webhook_api/manifest_routes.py) —
# never commit real values here (see this file's own header comment).
# Validated at Worker startup by attempting one real RS256 signing call
# with it; a malformed/truncated value fails loudly at boot, not silently
# on the first real job.
REVIEW_WORKER_GITHUB_APP_ID=
REVIEW_WORKER_GITHUB_APP_PRIVATE_KEY=

# Reuses the same base-URL/timeout pattern REVIEW_WEBHOOK_API_GITHUB_API_*
# above already establishes.
REVIEW_WORKER_GITHUB_API_BASE_URL=https://api.github.com
REVIEW_WORKER_GITHUB_API_TIMEOUT_SECONDS=10
# The GitHub-side retry/backoff policy's own configurable lever (a bare 5xx
# retries with short exponential backoff up to this many times; a
# 429/secondary-rate-limit response honors Retry-After up to a 10-second
# cap, treated as one bounded retry regardless of this value). `0` disables
# the mechanism wholesale.
REVIEW_WORKER_GITHUB_RETRY_MAX_ATTEMPTS=3

# --- Memory reaction polling (US-M3) --- bounds worst-case GitHub API call volume per
# poll: only the most-recently-posted comments for a PR, up to this many,
# are ever polled for reactions on a given poll.
REVIEW_WORKER_MEMORY_REACTION_POLL_MAX_COMMENTS_PER_POLL=50

# --- Memory-based suppression (US-M6/US-M7/US-M9/US-M12) --- an internal behavior toggle
# inside the already-registered `verification` step, not a separate pipeline
# stage of its own. Set false as the operational rollback lever if a bad
# threshold or a wrongly-approved entry starts suppressing findings it
# shouldn't — capture and the admin API keep running regardless.
REVIEW_WORKER_MEMORY_SUPPRESSION_ENABLED=true
# Tunable bootstrap config, not a hardcoded constant — the cosine-similarity
# threshold above which a candidate finding is suppressed.
REVIEW_WORKER_MEMORY_SIMILARITY_THRESHOLD=0.90
# Tunable bootstrap config — the exponential half-life, in days, an approved
# entry's similarity weight decays by (never a deletion/expiry job).
REVIEW_WORKER_MEMORY_DECAY_HALF_LIFE_DAYS=180.0

# --- Model routing (US-A14/US-A15/US-A16) --- mirrors
# REVIEW_WORKER_MEMORY_SUPPRESSION_ENABLED's exact pattern above. Set false
# as the operational rollback lever to disable the subsystem entirely
# (every stage then uses REVIEW_WORKER_LLM_MODEL directly, zero
# ModelRoutingConfig reads) — requires a Worker restart to flip, unlike a
# routing config change itself (US-A16's own "no restart required" applies
# to that, not to this flag). The day-to-day lever for a bad routing value is reverting the
# offending ModelRoutingConfig row via the Admin UI instead.
REVIEW_WORKER_MODEL_ROUTING_CONFIG_ENABLED=true

# --- Product knowledge: optional external provider (US-PK8..PK13) --- the
# provider itself (endpoint, display name, credential reference) is day-two
# config set in the Admin UI per platform/org/repo; only the *token* and the
# network policy are bootstrap config, below.
#
# Credential map: JSON object of operator-provisioned bearer tokens, each
# bound to the exact hosts it may be sent to. A token is never sent to a
# host outside its own `allowed_hosts`, and a provider setting may only
# reference a name listed here. Empty/unset = no credentials (an
# unauthenticated in-network provider still works). Treat as a secret.
#   {"knowhow-prod": {"token": "…", "allowed_hosts": ["knowhow.internal"]}}
REVIEW_WORKER_PRODUCT_KNOWLEDGE_CREDENTIALS=
# Kill switch (restart to flip). `false`: no provider is ever queried, even
# with provider settings present; one startup warning is logged.
REVIEW_WORKER_PRODUCT_KNOWLEDGE_ENABLED=true
# Per-call timeout and the whole provider branch's deadline, in seconds.
# When the feature is in use: call < deadline < the Context Builder's
# internal timeout (REVIEW_WORKER_CONTEXT_BUILDER_INTERNAL_TIMEOUT_SECONDS).
REVIEW_WORKER_PRODUCT_KNOWLEDGE_CALL_TIMEOUT_SECONDS=5
REVIEW_WORKER_PRODUCT_KNOWLEDGE_DEADLINE_SECONDS=10
# Egress policy: RFC1918/ULA ranges are allowed by default so an in-cluster
# provider works; loopback, link-local, cloud-metadata and unspecified
# addresses are always refused. Comma-separated allow-list of `host` or
# `*.suffix` entries; when non-empty, nothing else is contacted.
REVIEW_WORKER_PRODUCT_KNOWLEDGE_ALLOW_PRIVATE_NETWORKS=true
REVIEW_WORKER_PRODUCT_KNOWLEDGE_ENDPOINT_ALLOWLIST=

# --- Classifier verification (docs/specs/spec-classifier.md) ---
# Per-org setting `classifier_provider` (Admin UI) decides use; the credential comes from
# REVIEW_WORKER_PRODUCT_KNOWLEDGE_CREDENTIALS above. Pinned defaults, override only if needed:
REVIEW_WORKER_CLASSIFIER_TIMEOUT_SECONDS=10
REVIEW_WORKER_CLASSIFIER_MAX_CONCURRENCY=8
REVIEW_WORKER_CLASSIFIER_REDACTION_CONCURRENCY=4
REVIEW_WORKER_CLASSIFIER_MAX_STATE_BYTES=8000
# Public hosts only; true lets the Worker reach a private-address classifier (tests only).
REVIEW_WORKER_CLASSIFIER_ALLOW_PRIVATE_NETWORKS=false

# --- Findings-merge-and-output step (review/output.py) ---
# A single bootstrap-config kill-switch: when true, the full pipeline still
# runs (merge/redaction included) but every real GitHub write (PR review,
# check-run) is suppressed and the would-be payload is logged at `info`
# instead. Defaults to false, which posts real
# reviews; set true to validate a fresh deployment before trusting it with
# real writes.
REVIEW_WORKER_DRY_RUN=false

# --- Admin API ---
# The third deployable image (ADR-0001's 2026-09-20 amendment) — local
# login/session auth for the Admin UI. Shares REVIEW_DATABASE_URL above;
# no other entrypoint's env vars are reused.
REVIEW_ADMIN_API_ENVIRONMENT=development
REVIEW_ADMIN_API_LOG_LEVEL=INFO
ADMIN_API_PORT=8001

# `false` for a plain-HTTP local dev loopback only — every other
# deployment topology should keep this `true` (the shipped default),
# assuming a TLS-terminating proxy/Ingress in front. See
# apps/admin_api/settings.py's own field docstring.
REVIEW_ADMIN_API_SESSION_COOKIE_SECURE=false
REVIEW_ADMIN_API_SESSION_IDLE_TIMEOUT_MINUTES=30

# Required, no default: the initial admin account
# apps/admin_api/bootstrap.py creates on first boot (a no-op on every
# later restart once any admin user exists) — mirrors
# REVIEW_WEBHOOK_API_GITHUB_WEBHOOK_SECRET's own "no safe default"
# pattern. The password must be at least
# REVIEW_ADMIN_API_MIN_PASSWORD_LENGTH characters (12 by default) or the
# Admin API refuses to start.
REVIEW_ADMIN_API_ADMIN_BOOTSTRAP_USERNAME=admin
REVIEW_ADMIN_API_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-real-12-plus-character-password

# Postgres-backed windowed login-rate-limit counter — not
# the in-process InMemoryRateLimiter, which would undercount across
# apps/admin_api's multiple stateless replicas.
REVIEW_ADMIN_API_LOGIN_RATE_LIMIT_ATTEMPTS=5
REVIEW_ADMIN_API_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
REVIEW_ADMIN_API_MIN_PASSWORD_LENGTH=12

# Required, no default: signs the session-bound CSRF HMAC cookie
# — a dedicated secret, never a reuse of any session-
# cookie material. Generate a real one for anything beyond local dev,
# e.g. `openssl rand -hex 32`.
REVIEW_ADMIN_API_ADMIN_CSRF_SECRET=replace-with-a-real-csrf-secret

# This entrypoint's own local embedding model path — the Memory admin API's
# approve route (US-A9/US-M4) moved here from apps/webhook_api along with
# the rest of apps/webhook_api/admin_routes.py's handlers. Same
# default/shape as REVIEW_WORKER_EMBEDDING_MODEL_PATH below; checked to
# load and produce a real inference result once at Admin API startup, the
# same fail-fast pattern as that field's own check.
REVIEW_ADMIN_API_EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2

# Model routing's static-default tier (US-A14/US-A15) — the model
# `llmgateway.routing.FallbackModelRoutingResolver` falls open to when no
# `ModelRoutingConfig` row exists for a stage. Same literal default as
# REVIEW_WORKER_LLM_MODEL above; keep both in sync for the same
# static-default model to mean the same thing in both the UI and the Worker.
REVIEW_ADMIN_API_LLM_MODEL=local-model

# The admin-stats dashboard's Prometheus-reading adapter (US-A17).
# Defaults to the `prometheus` Compose service below, which only actually
# starts under the `observability` profile — GET /api/v1/stats degrades to
# a clean 5xx (never a hang) if it's not reachable.
REVIEW_ADMIN_API_PROMETHEUS_BASE_URL=http://prometheus:9090

# Product knowledge on the Admin API: the SAME credential map as the
# Worker's (the Admin API validates a provider setting's `credential_ref` against it and runs
# test-connection). A malformed map disables the product-knowledge routes
# instead of stopping the Admin API.
REVIEW_ADMIN_API_PRODUCT_KNOWLEDGE_CREDENTIALS=
REVIEW_ADMIN_API_PRODUCT_KNOWLEDGE_ENABLED=true
REVIEW_ADMIN_API_PRODUCT_KNOWLEDGE_CALL_TIMEOUT_SECONDS=5
REVIEW_ADMIN_API_PRODUCT_KNOWLEDGE_ALLOW_PRIVATE_NETWORKS=true
REVIEW_ADMIN_API_PRODUCT_KNOWLEDGE_ENDPOINT_ALLOWLIST=

# --- Observability (docs/specs/spec-observability.md) ---
# Shared, UNPREFIXED across the Webhook API, Worker and Admin API (like REVIEW_DATABASE_URL
# above) — the real OTel ecosystem convention, the same literal env var
# name every OTel SDK/exporter/collector already recognizes, not this
# repo's own REVIEW_WEBHOOK_API_*/REVIEW_WORKER_* prefix. Optional:
# unset (the shipped default) means no OTel SDK/exporter is constructed
# at all — zero overhead, zero connection attempts, zero log noise
# (US10's no-op default). Set to an OTel Collector's OTLP gRPC receiver
# address (e.g. `http://otel-collector:4317`) to enable metrics/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional OTLP auth headers for a collector that requires them (e.g.
# `authorization=Bearer <token>` for a bearer token), in OTel's own
# `key1=value1,key2=value2` wire format. Only meaningful when
# OTEL_EXPORTER_OTLP_ENDPOINT above is set; never commit a real token
# here (see this file's own header comment).
OTEL_EXPORTER_OTLP_HEADERS=

# --- `observability` Compose profile ---
# `docker compose --profile observability up` additionally starts an OTel
# Collector, Prometheus, and Grafana (pre-loaded with the shipped
# dashboard) alongside the default stack — see docker-compose.yml's own
# "observability profile" comment. That profile only brings the
# *containers* up; to actually see data in the bundled Grafana, also set
# OTEL_EXPORTER_OTLP_ENDPOINT above to the bundled collector's address:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# left unset here on purpose, matching every other value in this file —
# Compose profiles gate which *services* start, not env var values, so
# this one step can't be made to happen automatically just by passing
# `--profile observability`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_PROMETHEUS_PORT=8889

# --- Optional OIDC single sign-on for the Admin UI (US-A24) ---
# Local username/password login keeps working either way. Users must already
# exist (Admin UI -> Users); the ID token's preferred_username claim is
# matched to the local username. Register this redirect URI with the
# provider: https://<your-host>/api/v1/auth/oidc/callback
# REVIEW_ADMIN_API_OIDC_PROVIDER=authentik   # none | generic | authentik
# REVIEW_ADMIN_API_OIDC_CLIENT_ID=
# REVIEW_ADMIN_API_OIDC_CLIENT_SECRET=       # omit for a public (PKCE-only) client
# REVIEW_ADMIN_API_OIDC_REDIRECT_URI=
# authentik: https://authentik.example.com + the application slug
# REVIEW_ADMIN_API_OIDC_AUTHENTIK_BASE_URL=
# REVIEW_ADMIN_API_OIDC_AUTHENTIK_APP_SLUG=
# generic: the issuer URL (discovery is read from <issuer>/.well-known/openid-configuration)
# REVIEW_ADMIN_API_OIDC_ISSUER=
